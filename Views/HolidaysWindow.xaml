<Window x:Class="FeriasCampos.Views.HolidaysWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:texts="clr-namespace:FeriasCampos.Properties"
 Title="{x:Static texts:ScreenTexts.Holidays_Titulo}" Icon="{StaticResource summerIcon}"
 Width="1080" Height="680" MinWidth="920" MinHeight="560"
 WindowStartupLocation="CenterOwner" Background="#F8FAFC">
 <Grid x:Name="RootPanel" Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="{x:Static texts:ScreenTexts.Holidays_Titulo}" FontSize="28" FontWeight="Bold"/><TextBlock Text="{x:Static texts:ScreenTexts.Holidays_Subtitulo}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
   <Button Content="{x:Static texts:ScreenTexts.Holidays_Novo}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0878E8" Foreground="White" Click="NewClick"/>
  </Grid>
  <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,12"/>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="FormColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0">
    <DataGrid x:Name="HolidaysGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeight="48" GridLinesVisibility="Horizontal">
     <DataGrid.Columns>
      <DataGridTextColumn Header="{x:Static texts:ScreenTexts.Holidays_Nome}" Binding="{Binding Nome}" Width="*"/>
      <DataGridTextColumn Header="{x:Static texts:ScreenTexts.Holidays_Dia}" Binding="{Binding Dia, StringFormat=D2}" Width="55"/>
      <DataGridTextColumn Header="{x:Static texts:ScreenTexts.Holidays_Mes}" Binding="{Binding NomeMes}" SortMemberPath="Mes" Width="100"/>
      <DataGridTemplateColumn Header="{x:Static texts:ScreenTexts.Holidays_Acoes}" Width="155">
       <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
        <Button Content="{x:Static texts:ScreenTexts.Holidays_Editar}" Click="EditClick" Padding="8,5" Margin="0,0,5,0"/>
        <Button Content="{x:Static texts:ScreenTexts.Holidays_Excluir}" Click="DeleteClick" Padding="8,5" Foreground="#DC2626"/>
       </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Border>
   <Border x:Name="FormPanel" Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Visibility="Collapsed">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock x:Name="FormTitle" FontSize="20" FontWeight="Bold"/>
     <TextBlock Text="{x:Static texts:ScreenTexts.Holidays_Nome}" Margin="0,18,0,5"/>
     <TextBox x:Name="NameBox" Height="36" Padding="8" AutomationProperties.Name="{x:Static texts:ScreenTexts.Holidays_Nome}"/>
     <TextBlock Text="{x:Static texts:ScreenTexts.Holidays_Mes}" Margin="0,12,0,5"/>
     <ComboBox x:Name="MonthBox" Height="36" DisplayMemberPath="Nome" SelectedValuePath="Numero" SelectionChanged="MonthChanged" AutomationProperties.Name="{x:Static texts:ScreenTexts.Holidays_Mes}"/>
     <TextBlock Text="{x:Static texts:ScreenTexts.Holidays_Dia}" Margin="0,12,0,5"/>
     <ComboBox x:Name="DayBox" Height="36" AutomationProperties.Name="{x:Static texts:ScreenTexts.Holidays_Dia}"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{x:Static texts:ScreenTexts.Holidays_Cancelar}" Click="CancelClick" Margin="0,0,8,0"/>
      <Button Content="{x:Static texts:ScreenTexts.Holidays_Salvar}" Click="SaveClick" Background="#0878E8" Foreground="White"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>
