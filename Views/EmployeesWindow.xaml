<Window x:Class="FeriasCampos.Views.EmployeesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Colaboradores" Width="1120" Height="720" MinWidth="920" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Colaboradores" FontSize="28" FontWeight="Bold"/><TextBlock Text="Cadastre e consulte os colaboradores ativos" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Content="+  Novo colaborador" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0878E8" Foreground="White" Click="NewClick"/></Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="FormColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="EmployeesGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="48"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="CPF" Binding="{Binding Cpf}" Width="160"/><DataGridTextColumn Header="Admissão" Binding="{Binding Admissao, StringFormat=dd/MM/yyyy}" Width="140"/><DataGridTextColumn Header="Unidade" Binding="{Binding Unidade}" Width="180"/></DataGrid.Columns></DataGrid></Border>
   <Border x:Name="FormPanel" Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Grid><TextBlock Text="Novo colaborador" FontSize="20" FontWeight="Bold"/><Button Content="×" HorizontalAlignment="Right" BorderThickness="0" Padding="8,2" Click="CancelClick"/></Grid>
    <TextBlock Text="Nome completo *" Margin="0,18,0,5"/><TextBox x:Name="NameBox" Height="36" Padding="8"/>
    <TextBlock Text="CPF *" Margin="0,12,0,5"/><TextBox x:Name="CpfBox" Height="36" Padding="8" MaxLength="14"/>
    <TextBlock Text="Data de admissão *" Margin="0,12,0,5"/><DatePicker x:Name="AdmissionPicker" Height="36" SelectedDateFormat="Short"/>
    <TextBlock Text="Unidade *" Margin="0,12,0,5"/><ComboBox x:Name="UnitBox" Height="36" Padding="8" SelectedIndex="0" SelectedValuePath="Content"><ComboBoxItem Content="Washington Luiz"/><ComboBoxItem Content="Gurgel"/></ComboBox>
    <TextBlock x:Name="ErrorText" Foreground="#EF3340" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancelar" Click="CancelClick" Margin="0,0,8,0"/><Button Content="Salvar colaborador" Background="#0878E8" Foreground="White" Click="SaveClick"/></StackPanel>
   </StackPanel></ScrollViewer></Border>
  </Grid>
 </Grid>
</Window>
