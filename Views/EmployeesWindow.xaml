<Window x:Class="FeriasCampos.Views.EmployeesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:texts="clr-namespace:FeriasCampos.Properties" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="{StaticResource personIcon}" Title="{x:Static texts:ScreenTexts.EmployeesWindow_Colaboradores}" Width="1120" Height="720" MinWidth="920" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
 <Grid x:Name="RootPanel" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
  <Grid><StackPanel><StackPanel Orientation="Horizontal"><Image Source="{StaticResource personIcon}" Width="30" Height="30" Margin="0,0,10,0"/><TextBlock Text="{x:Static texts:ScreenTexts.EmployeesWindow_Colaboradores}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{x:Static texts:ScreenTexts.EmployeesWindow_CadastreAltereEExcluaColaboradores}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Content="{x:Static texts:ScreenTexts.EmployeesWindow_NovoColaborador}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0878E8" Foreground="White" Click="NewClick"/></Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="FormColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="EmployeesGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="48"><DataGrid.Columns><DataGridTextColumn Header="{x:Static texts:ScreenTexts.EmployeesWindow_Nome}" Binding="{Binding Nome}" Width="*"/><DataGridTextColumn Header="{x:Static texts:ScreenTexts.EmployeesWindow_CPF}" Binding="{Binding Cpf}" Width="130"/><DataGridTextColumn Header="{x:Static texts:ScreenTexts.EmployeesWindow_Admissao}" Binding="{Binding Admissao, StringFormat=dd/MM/yyyy}" Width="110"/><DataGridTextColumn Header="{x:Static texts:ScreenTexts.EmployeesWindow_Unidade}" Binding="{Binding Unidade}" Width="140"/><DataGridTemplateColumn Header="{x:Static texts:ScreenTexts.EmployeesWindow_Acoes}" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{x:Static texts:ScreenTexts.EmployeesWindow_Alterar}" Click="EditClick" Padding="10,5" Margin="0,0,6,0"/><Button Content="{x:Static texts:ScreenTexts.EmployeesWindow_Excluir}" Click="DeleteClick" Padding="10,5" Foreground="#DC2626"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
   <Border x:Name="FormPanel" Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <Grid><TextBlock x:Name="FormTitle" Text="{x:Static texts:ScreenTexts.EmployeesWindow_NovoColaborador2}" FontSize="20" FontWeight="Bold"/><Button Content="{x:Static texts:ScreenTexts.EmployeesWindow_Simbolo}" HorizontalAlignment="Right" BorderThickness="0" Padding="8,2" Click="CancelClick"/></Grid>
    <TextBlock Text="{x:Static texts:ScreenTexts.EmployeesWindow_NomeCompleto}" Margin="0,18,0,5"/><TextBox x:Name="NameBox" Height="36" Padding="8"/>
    <TextBlock Text="{x:Static texts:ScreenTexts.EmployeesWindow_CPF2}" Margin="0,12,0,5"/><TextBox x:Name="CpfBox" Height="36" Padding="8" MaxLength="14"/>
    <TextBlock Text="{x:Static texts:ScreenTexts.EmployeesWindow_DataDeAdmissao}" Margin="0,12,0,5"/><DatePicker x:Name="AdmissionPicker" Height="36" SelectedDateFormat="Short"/>
    <TextBlock Text="{x:Static texts:ScreenTexts.EmployeesWindow_Unidade2}" Margin="0,12,0,5"/><ComboBox x:Name="UnitBox" Height="36" Padding="8" SelectedIndex="0" SelectedValuePath="Content"><ComboBoxItem Content="{x:Static texts:ScreenTexts.EmployeesWindow_WashingtonLuiz}"/><ComboBoxItem Content="{x:Static texts:ScreenTexts.EmployeesWindow_Gurgel}"/></ComboBox>
    <StackPanel x:Name="PeriodsPanel" Visibility="Collapsed" Margin="0,20,0,0">
     <TextBlock Text="Períodos" FontSize="18" FontWeight="Bold"/>
     <TextBlock x:Name="EmptyPeriodsText" Text="Nenhum período cadastrado." Margin="0,8"/>
     <ItemsControl x:Name="EmployeePeriods"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0"><StackPanel>
       <TextBlock Text="{Binding Datas}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Saldo}" Foreground="#11845B" Margin="0,8,0,0"/>
       <TextBlock Text="{Binding Faltas}"/>
       <TextBlock Text="{Binding Folgas}"/>
       <Button Content="Excluir período" Tag="{Binding Id}" Click="DeletePeriodClick" Foreground="#DC2626" HorizontalAlignment="Right" Margin="0,8,0,0"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#EF3340" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="{x:Static texts:ScreenTexts.EmployeesWindow_Cancelar}" Click="CancelClick" Margin="0,0,8,0"/><Button Content="{x:Static texts:ScreenTexts.EmployeesWindow_SalvarColaborador}" Background="#0878E8" Foreground="White" Click="SaveClick"/></StackPanel>
   </StackPanel></ScrollViewer></Border>
  </Grid>
 </Grid>
</Window>
