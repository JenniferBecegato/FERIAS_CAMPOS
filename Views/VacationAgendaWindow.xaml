<Window x:Class="FeriasCampos.Views.VacationAgendaWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:texts="clr-namespace:FeriasCampos.Properties" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{x:Static texts:ScreenTexts.VacationAgendaWindow_AgendaDeFerias}" Icon="{StaticResource travelIcon}" WindowState="Maximized"
 Width="1440" Height="900" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F3F6FC">
 <Grid Margin="24" Language="pt-BR">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <Button DockPanel.Dock="Right" Content="{x:Static texts:ScreenTexts.VacationAgendaWindow_VoltarAoPainel}" Click="CloseClick" VerticalAlignment="Center"/>
   <StackPanel><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_AgendaDeFerias2}" FontSize="30" FontWeight="Bold"/><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_TempoDeDescansarTudoOrganizadoPorAqui}" Foreground="#64748B" Margin="0,5,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
     <Button Content="{x:Static texts:ScreenTexts.VacationAgendaWindow_Simbolo}" Click="PreviousClick" FontSize="20" Padding="15,3" ToolTip="{x:Static texts:ScreenTexts.VacationAgendaWindow_MesAnterior}" AutomationProperties.Name="{x:Static texts:ScreenTexts.VacationAgendaWindow_MesAnterior}"/>
     <Button Content="{x:Static texts:ScreenTexts.VacationAgendaWindow_Hoje}" Click="TodayClick" Margin="8,0"/>
     <Button Content="{x:Static texts:ScreenTexts.VacationAgendaWindow_Simbolo2}" Click="NextClick" FontSize="20" Padding="15,3" ToolTip="{x:Static texts:ScreenTexts.VacationAgendaWindow_ProximoMes}" AutomationProperties.Name="{x:Static texts:ScreenTexts.VacationAgendaWindow_ProximoMes}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Width="350" Margin="0,0,12,0">
     <TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_PesquisarColaborador}" FontWeight="SemiBold" Margin="0,0,0,7"/>
     <ComboBox x:Name="EmployeeSearch" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MaxDropDownHeight="280" Height="36" Padding="8,4" DisplayMemberPath="Label" SelectionChanged="EmployeeChanged" AutomationProperties.Name="{x:Static texts:ScreenTexts.VacationAgendaWindow_PesquisarColaborador}"/>
    </StackPanel>
    <Button DockPanel.Dock="Left" Content="{x:Static texts:ScreenTexts.VacationAgendaWindow_Limpar}" Click="ClearClick" VerticalAlignment="Bottom"/>
    <StackPanel Margin="14,0,12,0" MaxWidth="300" HorizontalAlignment="Left">
     <TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_PeriodoDeFerias}" FontWeight="SemiBold" Margin="0,0,0,7"/>
     <ComboBox x:Name="VacationPeriodSelector" IsEnabled="False" MinWidth="240" Height="36" Padding="8,4" DisplayMemberPath="Label" SelectionChanged="VacationPeriodChanged" AutomationProperties.Name="{x:Static texts:ScreenTexts.VacationAgendaWindow_PeriodoDeFerias}" ToolTip="{x:Static texts:ScreenTexts.VacationAgendaWindow_SelecioneUmColaboradorParaEscolherOPeriodo}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,18">
      <DockPanel Margin="0,0,0,10"><TextBlock x:Name="MonthTitle" FontSize="24" FontWeight="Bold"/><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_HojeContornoDiaSelecionado}" Foreground="#0878E8" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      <WrapPanel VerticalAlignment="Center">
       <TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_IrPara}" VerticalAlignment="Center" Margin="0,0,8,6"/>
       <DatePicker x:Name="NavigationDate" Width="140" SelectedDateFormat="Short" SelectedDateChanged="NavigationDateChanged" Margin="0,0,12,6" ToolTip="{x:Static texts:ScreenTexts.VacationAgendaWindow_DigiteUmaDataOuCliqueNoTituloDo}" AutomationProperties.Name="{x:Static texts:ScreenTexts.VacationAgendaWindow_IrParaDiaMesEAno}"/>
       <Button Content="{x:Static texts:ScreenTexts.VacationAgendaWindow_Ano}" Tag="-12" Click="MoveYearClick" Margin="0,0,4,6" Padding="8,4"/>
       <Button Content="{x:Static texts:ScreenTexts.VacationAgendaWindow_Ano2}" Tag="12" Click="MoveYearClick" Margin="0,0,12,6" Padding="8,4"/>
       <Button Content="{x:Static texts:ScreenTexts.VacationAgendaWindow_Dia}" Tag="-1" Click="MoveDayClick" Margin="0,0,4,6" Padding="8,4"/>
       <Button Content="{x:Static texts:ScreenTexts.VacationAgendaWindow_Dia2}" Tag="1" Click="MoveDayClick" Margin="0,0,0,6" Padding="8,4"/>
      </WrapPanel>
     </StackPanel>
     <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8"><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_DOM}"/><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_SEG}"/><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_TER}"/><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_QUA}"/><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_QUI}"/><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_SEX}"/><TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_SAB}"/></UniformGrid>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="WeeksPanel"/></ScrollViewer>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_Ferias}" FontSize="20" FontWeight="Bold"/>
     <TextBlock x:Name="SummaryText" Grid.Row="1" Foreground="#64748B" Margin="0,8,0,16" TextWrapping="Wrap"/>
     <DataGrid x:Name="AgendaTable" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EDF3" BorderThickness="0" Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC" ColumnHeaderHeight="36" RowHeight="64" SelectionMode="Single">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="{x:Static texts:ScreenTexts.VacationAgendaWindow_ColaboradorPeriodoCompleto}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Border BorderBrush="{Binding Color}" BorderThickness="4,0,0,0" Padding="8,4" Margin="0,5"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Dates}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/></StackPanel></Border>
       </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="{x:Static texts:ScreenTexts.VacationAgendaWindow_Dias}" Binding="{Binding Days}" Width="42"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="EmptyText" Grid.Row="2" Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_NenhumPeriodoDeFeriasNesteMes}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B" Visibility="Collapsed"/>
     <TextBlock Grid.Row="3" Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_AsDatasEOsDiasRepresentamOPeriodo}" TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,14,0,0"/>
    </Grid>
   </Border>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Text="{x:Static texts:ScreenTexts.VacationAgendaWindow_CadaColaboradorTemUmaCorENasFaixas}" Foreground="#64748B" Margin="0,14,0,0"/>
 </Grid>
</Window>
