    <Button HorizontalContentAlignment="Left" Margin="0,5" Click="ModuleClick" Tag="{x:Static texts:ScreenTexts.MainWindow_AgendaDeFerias}" AutomationProperties.Name="{x:Static texts:ScreenTexts.MainWindow_AgendaDeFerias}"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource travelIcon}" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="{x:Static texts:ScreenTexts.MainWindow_AgendaDeFerias}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
