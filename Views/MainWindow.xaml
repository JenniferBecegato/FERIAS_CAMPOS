<Window x:Class="FeriasCampos.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:texts="clr-namespace:FeriasCampos.Properties" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="{StaticResource programIcon}" Title="{x:Static texts:ScreenTexts.MainWindow_ControleDeFerias}" Width="1600" Height="900" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F8FAFC">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*" MinWidth="640"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition/></Grid.RowDefinitions>
