<Window x:Class="FeriasCampos.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Controle de Férias" Width="1600" Height="900" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#F8FAFC">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*" MinWidth="640"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
  <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="♟" Foreground="#0878E8" FontSize="34" Margin="8,0,10,0"/><StackPanel><TextBlock Text="COMPETÊNCIA" FontWeight="Bold"/><TextBlock Text="07/2026" FontWeight="SemiBold"/></StackPanel></StackPanel>
   <StackPanel Grid.Row="1">
    <Button Content="⌂   Dashboard" Background="#0878E8" Foreground="White" HorizontalContentAlignment="Left" Margin="0,5"/>
    <Button Content="♙   Colaboradores" HorizontalContentAlignment="Left" Margin="0,5" Click="ModuleClick" Tag="Colaboradores"/>
    <Button Content="⇧   Importar PDF" HorizontalContentAlignment="Left" Margin="0,5" Click="ImportClick"/>
    <Button Content="▣   Agenda de Férias" HorizontalContentAlignment="Left" Margin="0,5" Click="ModuleClick" Tag="Agenda de Férias"/>
    <Button Content="▥   Relatórios" HorizontalContentAlignment="Left" Margin="0,5" Click="ModuleClick" Tag="Relatórios"/>
    <Button Content="⚖   Regras" HorizontalContentAlignment="Left" Margin="0,5" Click="ModuleClick" Tag="Regras"/>
    <Button Content="⚙   Configurações" HorizontalContentAlignment="Left" Margin="0,5" Click="ModuleClick" Tag="Configurações"/>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="14,12"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="120"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
   <Grid><TextBlock Text="Controle de Férias" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="⇧  Importar relatório PDF" HorizontalAlignment="Right" BorderBrush="#0878E8" Foreground="#0878E8" Click="ImportClick"/></Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,10,6,0" Padding="12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="48" Height="48" Background="#DDEEFF" CornerRadius="24"><TextBlock Text="♙" FontSize="22" Foreground="#0878E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TotalText" FontSize="20" FontWeight="Bold"/><TextBlock Text="Total de colaboradores" FontSize="11"/><TextBlock Text="Ativos" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,10,6,0" Padding="12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="48" Height="48" Background="#DDF6E9" CornerRadius="24"><TextBlock Text="▣" FontSize="22" Foreground="#13A86B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ScheduledText" FontSize="20" FontWeight="Bold"/><TextBlock Text="Férias programadas" FontSize="11"/><TextBlock Text="Nos próximos 60 dias" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,10,6,0" Padding="12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="48" Height="48" Background="#FFF2D9" CornerRadius="24"><TextBlock Text="◷" FontSize="22" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="DueText" FontSize="20" FontWeight="Bold"/><TextBlock Text="Próximas do vencimento" FontSize="11"/><TextBlock Text="Até 60 dias" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel></Border>
    <Border Grid.Column="3" Style="{StaticResource Card}" Margin="6,10,0,0" Padding="12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="48" Height="48" Background="#FFE2E5" CornerRadius="24"><TextBlock Text="⌛" FontSize="22" Foreground="#EF3340" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="PendingText" FontSize="20" FontWeight="Bold"/><TextBlock Text="Pendentes" FontSize="11"/><TextBlock Text="Sem programação" FontSize="10" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel></Border>
   </Grid>
   <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><Grid><Grid.Resources>
    <Style x:Key="PeriodCellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#26364D"/></Style>
    <Style x:Key="PeriodNumberText" TargetType="TextBlock" BasedOn="{StaticResource PeriodCellText}"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
    <Style x:Key="StatusBadge" TargetType="Border"><Setter Property="Width" Value="86"/><Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Background" Value="#E8F2FF"/><Setter Property="VerticalAlignment" Value="Center"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Completo"><Setter Property="Background" Value="#DDF6E9"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Atenção"><Setter Property="Background" Value="#FFF1D8"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Urgente"><Setter Property="Background" Value="#FFE3E6"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Vencido"><Setter Property="Background" Value="#FFE3E6"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="StatusText" TargetType="TextBlock"><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#0878E8"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Completo"><Setter Property="Foreground" Value="#11845B"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Atenção"><Setter Property="Foreground" Value="#D98200"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Urgente"><Setter Property="Foreground" Value="#D92D3A"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Vencido"><Setter Property="Foreground" Value="#D92D3A"/></DataTrigger></Style.Triggers></Style>
   </Grid.Resources><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions>
    <Grid Margin="16,0"><TextBlock Text="Controle de períodos" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBox x:Name="SearchBox" Width="240" Height="38" Padding="12,8" Text="" ToolTip="Buscar colaborador" KeyUp="SearchKeyUp"/><Button Content="⚑  Filtros ⌄" Margin="8,0,0,0"/></StackPanel></Grid>
    <DataGrid x:Name="PeriodsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EDF3" BorderThickness="0" RowHeight="51" ColumnHeaderHeight="52" SelectionChanged="PeriodSelected" CanUserResizeRows="False" CanUserReorderColumns="False" SelectionUnit="FullRow">
     <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EEF7FF"/><Setter Property="Foreground" Value="#10213E"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F7FAFD"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
     <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></DataGrid.CellStyle>
     <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#E4E9F0"/><Setter Property="BorderThickness" Value="0,1,0,1"/><Setter Property="Padding" Value="4,6"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#34445B"/></Style></DataGrid.ColumnHeaderStyle>
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="29" Height="29" CornerRadius="15" Background="#0878E8" HorizontalAlignment="Center"><TextBlock Text="{Binding Iniciais}" Foreground="White" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Colaborador" Width="*" MinWidth="142"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Colaborador}" Style="{StaticResource PeriodCellText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Width="120"><DataGridTemplateColumn.Header><TextBlock Text="Período aquisitivo" TextWrapping="Wrap" TextAlignment="Center"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox Tag="{Binding ColaboradorId}" SelectedValue="{Binding Id, Mode=OneWay}" SelectedValuePath="Id" DisplayMemberPath="PeriodoResumido" Loaded="PeriodGridSelectorLoaded" SelectionChanged="PeriodGridSelectorChanged" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Padding="1" FontSize="10" ToolTip="Selecionar período aquisitivo"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Vencimento" Binding="{Binding Vencimento}" Width="90" ElementStyle="{StaticResource PeriodNumberText}"/>
      <DataGridTemplateColumn Width="69"><DataGridTemplateColumn.Header><TextBlock Text="Saldo inicial&#x0a;(dias)" TextAlignment="Center"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SaldoInicial}" Style="{StaticResource PeriodNumberText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Width="82"><DataGridTemplateColumn.Header><TextBlock Text="Férias agendadas&#x0a;(dias)" TextAlignment="Center"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Agendados}" Style="{StaticResource PeriodNumberText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Width="62"><DataGridTemplateColumn.Header><TextBlock Text="Vendido&#x0a;(dias)" TextAlignment="Center"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Vendidos}" Style="{StaticResource PeriodNumberText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Width="58"><DataGridTemplateColumn.Header><TextBlock Text="Folgas&#x0a;(dias)" TextAlignment="Center"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Folgas}" Style="{StaticResource PeriodNumberText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Width="78"><DataGridTemplateColumn.Header><TextBlock Text="Saldo restante&#x0a;(dias)" TextAlignment="Center"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Saldo}" Style="{StaticResource PeriodNumberText}" FontWeight="Bold" FontSize="14"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Status" Width="98"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Center"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="2" Margin="12,0"><TextBlock x:Name="PaginationSummaryText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="PreviousPageButton" Content="‹" Width="31" Height="30" Padding="0" Click="PreviousPageClick"/><Border Width="31" Height="30" CornerRadius="5" Background="#0878E8" Margin="8,0"><TextBlock x:Name="CurrentPageText" Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Button x:Name="NextPageButton" Content="›" Width="31" Height="30" Padding="0" Click="NextPageClick"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Linhas por página:" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,6"><TextBlock Text="10 ⌄" FontSize="11"/></Border></StackPanel></Grid>
   </Grid></Border>
  </Grid>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,14,12">
   <Border Style="{StaticResource Card}"><StackPanel><Grid><TextBlock Text="Detalhes do colaborador" FontSize="16" FontWeight="Bold"/><TextBlock Text="×" FontSize="24" HorizontalAlignment="Right"/></Grid>
    <StackPanel Orientation="Horizontal" Margin="0,16,0,12"><Border Width="48" Height="48" CornerRadius="24" Background="#0878E8"><TextBlock x:Name="InitialsText" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmployeeText" Margin="12,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Período aquisitivo" VerticalAlignment="Center"/><ComboBox x:Name="PeriodSelector" Grid.Column="1" MinWidth="178" Height="24" DisplayMemberPath="PeriodoResumido" SelectedValuePath="Id" SelectionChanged="PeriodSelectorChanged"/>
     <TextBlock Grid.Row="1" Text="Vencimento"/><TextBlock x:Name="ExpiryText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"/>
     <TextBlock Grid.Row="2" Text="Direito total"/><TextBlock x:Name="RightText" Grid.Row="2" Grid.Column="1" Foreground="#0878E8" FontWeight="Bold" HorizontalAlignment="Right"/>
     <TextBlock Grid.Row="3" Text="Férias gozadas"/><TextBlock x:Name="UsedText" Grid.Row="3" Grid.Column="1" Foreground="#0878E8" FontWeight="Bold" HorizontalAlignment="Right"/>
     <TextBlock Grid.Row="4" Text="Dias vendidos"/><TextBlock x:Name="SoldText" Grid.Row="4" Grid.Column="1" Foreground="#0878E8" FontWeight="Bold" HorizontalAlignment="Right"/>
     <TextBlock Grid.Row="5" Text="Folgas descontadas"/><TextBlock x:Name="DaysOffText" Grid.Row="5" Grid.Column="1" Foreground="#0878E8" FontWeight="Bold" HorizontalAlignment="Right"/>
    </Grid>
    <Separator Margin="0,10"/><Grid><TextBlock Text="Saldo disponível" FontWeight="Bold"/><TextBlock x:Name="BalanceText" HorizontalAlignment="Right" Foreground="#11845B" FontSize="16" FontWeight="Bold"/></Grid>
    <Button Content="▣  +  Agendar férias" BorderBrush="#0878E8" Foreground="#0878E8" Margin="0,10,0,5" Click="ScheduleClick"/><Button Content="♙  +  Registrar folga" BorderBrush="#F59E0B" Foreground="#D98200" Click="DayOffClick"/>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0"><StackPanel><TextBlock Text="Histórico de movimentações" FontWeight="Bold"/><ItemsControl x:Name="HistoryList" Margin="0,5"/><TextBlock x:Name="RemainingText" Foreground="#11845B" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Border>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel>
    <Grid Margin="0,0,0,12"><Button Content="‹" Width="34" Height="30" Padding="0" Foreground="#0878E8" FontSize="20" BorderThickness="0" HorizontalAlignment="Left" Click="PreviousAgendaMonthClick"/><TextBlock x:Name="AgendaMonthText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0878E8" FontSize="16" FontWeight="Bold"/><Button Content="›" Width="34" Height="30" Padding="0" Foreground="#0878E8" FontSize="20" BorderThickness="0" HorizontalAlignment="Right" Click="NextAgendaMonthClick"/></Grid>
    <UniformGrid Columns="7" Margin="0,0,0,5"><TextBlock Text="D" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="S" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="T" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Q" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Q" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="S" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="S" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></UniformGrid>
    <UniformGrid x:Name="AgendaDaysGrid" Columns="7" Rows="6"/>
    <WrapPanel x:Name="AgendaLegend" HorizontalAlignment="Center" Margin="0,12,0,2"/>
    <TextBlock x:Name="EmptyAgendaText" Text="Nenhuma férias agendada neste mês" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
    <Button Content="Ver agenda completa" Foreground="#0878E8" BorderThickness="0" Margin="0,8,0,0" Click="ModuleClick" Tag="Agenda de Férias"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
