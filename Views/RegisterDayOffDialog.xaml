<Window x:Class="FeriasCampos.Views.RegisterDayOffDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:texts="clr-namespace:FeriasCampos.Properties" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="{StaticResource homeIcon}" Title="{x:Static texts:ScreenTexts.RegisterDayOffDialog_RegistrarFolga}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#F8FAFC">
 <StackPanel Margin="26">
  <StackPanel Orientation="Horizontal"><Image Source="{StaticResource homeIcon}" Width="30" Height="30" Margin="0,0,10,0"/><TextBlock Text="{x:Static texts:ScreenTexts.RegisterDayOffDialog_RegistrarFolga}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
  <Border Style="{StaticResource Card}" Margin="0,18,0,12">
   <StackPanel>
    <TextBlock x:Name="EmployeeText" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock x:Name="PeriodText" Margin="0,6,0,0"/>
    <TextBlock x:Name="BalanceText" Margin="0,6,0,0" Foreground="#11845B"/>
    <TextBlock Text="{x:Static texts:ScreenTexts.RegisterDayOffDialog_QuantidadeDeDias}" Margin="0,18,0,5"/>
    <TextBox x:Name="DaysBox"/>
    <TextBlock Text="{x:Static texts:ScreenTexts.RegisterDayOffDialog_Justificativa}" Margin="0,12,0,5"/>
    <TextBox x:Name="ReasonBox" Height="85" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="ValidationText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="CancelButton" Content="{x:Static texts:ScreenTexts.RegisterDayOffDialog_Cancelar}" IsCancel="True" Margin="0,0,8,0"/>
   <Button x:Name="SaveButton" Content="{x:Static texts:ScreenTexts.RegisterDayOffDialog_RegistrarFolga}" Click="SaveClick" Background="#D98200" Foreground="White"/>
  </StackPanel>
 </StackPanel>
</Window>
