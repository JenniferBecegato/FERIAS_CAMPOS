<Window x:Class="FeriasCampos.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:texts="clr-namespace:FeriasCampos.Properties" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="{StaticResource settingsIcon}" Title="{x:Static texts:ScreenTexts.SettingsWindow_Configuracoes}" Width="560" Height="535" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><StackPanel Orientation="Horizontal"><Image Source="{StaticResource settingsIcon}" Width="30" Height="30" Margin="0,0,10,0"/><TextBlock Text="{x:Static texts:ScreenTexts.SettingsWindow_Configuracoes}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{x:Static texts:ScreenTexts.SettingsWindow_DefinaAsRegrasUsadasNoAgendamentoDeFerias}" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20"><StackPanel>
   <TextBlock Text="{x:Static texts:ScreenTexts.SettingsWindow_RegrasDeAgendamento}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
   <CheckBox x:Name="BlockNoticeCheckBox" FontSize="14" VerticalContentAlignment="Center">
    <TextBlock Text="{x:Static texts:ScreenTexts.SettingsWindow_BloquearFeriasComMenosDe30DiasDe}" TextWrapping="Wrap"/>
   </CheckBox>
   <TextBlock Text="{x:Static texts:ScreenTexts.SettingsWindow_QuandoMarcadaAsDatasQueNaoCumpremA}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="24,10,0,0"/>
   <CheckBox x:Name="BlockWeeklyRestCheckBox" FontSize="14" VerticalContentAlignment="Center" Margin="0,20,0,0">
    <TextBlock Text="{x:Static texts:ScreenTexts.SettingsWindow_BloquearInicioNaSextaFeiraENoSabado}" TextWrapping="Wrap"/>
   </CheckBox>
   <TextBlock Text="{x:Static texts:ScreenTexts.SettingsWindow_ConsideraODomingoComoRepousoSemanalQuandoDesmarcada}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="24,10,0,0"/>
   <CheckBox x:Name="DiscountAbsencesCheckBox" FontSize="14" VerticalContentAlignment="Center" Margin="0,20,0,0">
    <TextBlock Text="{x:Static texts:ScreenTexts.SettingsWindow_DescontarSaldoDeFeriasPorFaltasNaoJustificadas}" TextWrapping="Wrap"/>
   </CheckBox>
   <TextBlock Text="{x:Static texts:ScreenTexts.SettingsWindow_QuandoMarcadaAplicaAoPeriodoAsFaixasDe}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="24,10,0,0"/>
  </StackPanel></Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{x:Static texts:ScreenTexts.SettingsWindow_Cancelar}" Click="CancelClick" Margin="0,0,8,0"/><Button Content="{x:Static texts:ScreenTexts.SettingsWindow_Salvar}" Click="SaveClick" Background="#0878E8" Foreground="White"/></StackPanel>
 </Grid>
</Window>
