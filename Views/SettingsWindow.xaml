<Window x:Class="FeriasCampos.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configurações" Width="560" Height="535" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Configurações" FontSize="25" FontWeight="Bold"/><TextBlock Text="Defina as regras usadas no agendamento de férias." Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20"><StackPanel>
   <TextBlock Text="Regras de agendamento" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
   <CheckBox x:Name="BlockNoticeCheckBox" FontSize="14" VerticalContentAlignment="Center">
    <TextBlock Text="Bloquear férias com menos de 30 dias de antecedência" TextWrapping="Wrap"/>
   </CheckBox>
   <TextBlock Text="Quando marcada, as datas que não cumprem a antecedência ficam indisponíveis no calendário. Quando desmarcada, o sistema permite o agendamento e exibe apenas um aviso." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="24,10,0,0"/>
   <CheckBox x:Name="BlockWeeklyRestCheckBox" FontSize="14" VerticalContentAlignment="Center" Margin="0,20,0,0">
    <TextBlock Text="Bloquear início na sexta-feira e no sábado" TextWrapping="Wrap"/>
   </CheckBox>
   <TextBlock Text="Considera o domingo como repouso semanal. Quando desmarcada, o sistema permite o agendamento e exibe um aviso." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="24,10,0,0"/>
   <CheckBox x:Name="DiscountAbsencesCheckBox" FontSize="14" VerticalContentAlignment="Center" Margin="0,20,0,0">
    <TextBlock Text="Descontar saldo de férias por faltas não justificadas" TextWrapping="Wrap"/>
   </CheckBox>
   <TextBlock Text="Quando marcada, aplica ao período as faixas de redução previstas na CLT. Quando desmarcada, as faltas continuam registradas, mas não reduzem o saldo." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="24,10,0,0"/>
  </StackPanel></Border>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="CancelClick" Margin="0,0,8,0"/><Button Content="Salvar" Click="SaveClick" Background="#0878E8" Foreground="White"/></StackPanel>
 </Grid>
</Window>
