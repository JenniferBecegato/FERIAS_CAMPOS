<Window x:Class="FeriasCampos.Views.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Regras de Férias"
        Width="1040" Height="780" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
 <Window.Resources>
  <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
   <Setter Property="Margin" Value="0,0,0,14"/>
   <Setter Property="Padding" Value="20"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="18"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="RuleText" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="LineHeight" Value="22"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,3"/>
  </Style>
  <Style x:Key="TableCell" TargetType="Border">
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="12,8"/>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,22">
   <Grid>
    <StackPanel>
     <TextBlock Text="Regras de Férias" FontSize="28" FontWeight="Bold"/>
     <TextBlock Text="Manual de consulta para programação e conferência" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Content="Fechar" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseClick"/>
   </Grid>
  </Border>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="28,22,28,12" MaxWidth="980">
    <Border Background="#FFF7E6" BorderBrush="#F5C66D" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="Conteúdo orientativo" FontSize="15" FontWeight="Bold" Foreground="#A35A00"/>
      <TextBlock Style="{StaticResource RuleText}" Text="Este manual resume regras gerais da CLT. Ele não substitui a validação do RH, da contabilidade ou do jurídico. Convenções e acordos coletivos podem estabelecer condições mais favoráveis. Nem todas as regras descritas abaixo são automatizadas pela versão atual do sistema."/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Visão rápida"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Background="#ECFDF5" CornerRadius="8" Padding="15">
        <StackPanel>
         <TextBlock Text="✓ Permitido" Foreground="#11845B" FontSize="16" FontWeight="Bold" Margin="0,0,0,7"/>
         <TextBlock Style="{StaticResource RuleText}" Text="• Programar dentro do saldo e do período concessivo."/>
         <TextBlock Style="{StaticResource RuleText}" Text="• Dividir em até três parcelas, com concordância do empregado e observando os mínimos legais."/>
         <TextBlock Style="{StaticResource RuleText}" Text="• Converter até um terço do direito em abono, quando solicitado pelo empregado no prazo."/>
         <TextBlock Style="{StaticResource RuleText}" Text="• Aplicar regra coletiva mais favorável, após conferência do RH."/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Background="#FFF1F2" CornerRadius="8" Padding="15">
        <StackPanel>
         <TextBlock Text="× Não permitido" Foreground="#C6283A" FontSize="16" FontWeight="Bold" Margin="0,0,0,7"/>
         <TextBlock Style="{StaticResource RuleText}" Text="• Agendar mais dias do que o saldo disponível."/>
         <TextBlock Style="{StaticResource RuleText}" Text="• Criar quarta parcela ou parcela com menos de 5 dias."/>
         <TextBlock Style="{StaticResource RuleText}" Text="• Iniciar nos dois dias anteriores a feriado ou repouso semanal remunerado."/>
         <TextBlock Style="{StaticResource RuleText}" Text="• Impor unilateralmente a venda de dias ou descontar uma falta como um dia de férias."/>
        </StackPanel>
       </Border>
      </Grid>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Como o sistema funciona atualmente"/>
      <WrapPanel Margin="0,0,0,10">
       <Border Background="#FFE5E8" CornerRadius="12" Padding="10,5" Margin="0,0,8,6"><TextBlock Text="BLOQUEADO PELO SISTEMA" Foreground="#C6283A" FontSize="12" FontWeight="Bold"/></Border>
       <Border Background="#FFF3D6" CornerRadius="12" Padding="10,5" Margin="0,0,8,6"><TextBlock Text="PERMITIDO COM AVISO" Foreground="#A35A00" FontSize="12" FontWeight="Bold"/></Border>
       <Border Background="#E8F1FF" CornerRadius="12" Padding="10,5" Margin="0,0,8,6"><TextBlock Text="CONFERÊNCIA DO RH" Foreground="#0866C6" FontSize="12" FontWeight="Bold"/></Border>
      </WrapPanel>
      <TextBlock Style="{StaticResource RuleText}" Text="• O sistema valida em conjunto as parcelas novas e existentes: bloqueia saldo insuficiente, sobreposição, períodos com menos de 5 dias, quarta parcela e divisões que não possam conter uma parcela de pelo menos 14 dias."/>
      <TextBlock Style="{StaticResource RuleText}" Text="• O sistema bloqueia o início nos dois dias anteriores aos feriados cadastrados e limita as datas ao dia atual, ao saldo disponível e ao vencimento do período."/>
      <TextBlock Style="{StaticResource RuleText}" Text="• Considerando o domingo como repouso semanal padrão, inícios na sexta-feira ou no sábado são bloqueados ou permitidos com aviso, conforme a configuração."/>
      <TextBlock Style="{StaticResource RuleText}" Text="• A antecedência inferior a 30 dias pode ser bloqueada ou apenas alertada, conforme a configuração descrita adiante."/>
      <TextBlock Style="{StaticResource RuleText}" Text="• O abono é registrado junto às parcelas e limitado automaticamente a um terço do direito. A prova de que o empregado o requereu até 15 dias antes do fim do período aquisitivo permanece sob conferência do RH."/>
      <TextBlock Style="{StaticResource RuleText}" Text="• Faltas, afastamentos, pagamento, férias coletivas, regras familiares, convenções e demais situações especiais ainda dependem de conferência e registro do RH."/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Aquisição, concessão e vencimento"/>
      <TextBlock Style="{StaticResource RuleText}" Text="O direito é adquirido após cada período de 12 meses de contrato. O empregador dispõe dos 12 meses seguintes para conceder as férias, escolhendo a época dentro das limitações legais."/>
      <TextBlock Style="{StaticResource RuleText}" Text="Férias concedidas depois do período concessivo exigem tratamento legal em dobro. Se apenas parte dos dias ultrapassar o prazo, os dias excedentes devem ser identificados separadamente. Casos vencidos ou parcialmente vencidos devem ser encaminhados ao RH."/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Faltas injustificadas"/>
      <TextBlock Style="{StaticResource RuleText}" Text="A quantidade de faltas injustificadas altera o total do direito. Não se desconta simplesmente um dia de férias para cada falta. Ausências legalmente justificadas não entram nesse cálculo e devem ser classificadas corretamente." Margin="0,0,0,12"/>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" CornerRadius="6">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Border Style="{StaticResource TableCell}" Background="#F1F5F9"><TextBlock Text="Faltas no período aquisitivo" FontWeight="Bold"/></Border>
        <Border Grid.Column="1" Style="{StaticResource TableCell}" Background="#F1F5F9"><TextBlock Text="Direito a férias" FontWeight="Bold"/></Border>
        <Border Grid.Row="1" Style="{StaticResource TableCell}"><TextBlock Text="Até 5"/></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="30 dias"/></Border>
        <Border Grid.Row="2" Style="{StaticResource TableCell}"><TextBlock Text="6 a 14"/></Border><Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="24 dias"/></Border>
        <Border Grid.Row="3" Style="{StaticResource TableCell}"><TextBlock Text="15 a 23"/></Border><Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="18 dias"/></Border>
        <Border Grid.Row="4" Style="{StaticResource TableCell}"><TextBlock Text="24 a 32"/></Border><Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="12 dias"/></Border>
        <Border Grid.Row="5" Style="{StaticResource TableCell}"><TextBlock Text="Mais de 32"/></Border><Border Grid.Row="5" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="Sem direito no período"/></Border>
       </Grid>
      </Border>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Fracionamento e início das férias"/>
      <TextBlock Style="{StaticResource RuleText}" Text="O fracionamento exige concordância do empregado e admite no máximo três períodos. Um deles deve possuir pelo menos 14 dias corridos e cada um dos demais, pelo menos 5 dias corridos. A soma de gozo, abono e saldo não pode superar o direito adquirido."/>
      <TextBlock Style="{StaticResource RuleText}" Text="O início é proibido nos dois dias anteriores a feriado ou repouso semanal remunerado. A conferência deve considerar feriados nacionais, estaduais, municipais e regras coletivas cadastradas."/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Aviso, pagamento e abono pecuniário"/>
      <TextBlock Style="{StaticResource RuleText}" Text="O aviso deve ser escrito e entregue com antecedência mínima de 30 dias, com registro da ciência. A remuneração das férias e o eventual abono devem ser pagos até dois dias antes do início."/>
      <TextBlock Style="{StaticResource RuleText}" Text="O abono é uma opção do empregado, nunca uma decisão unilateral do empregador. Pode alcançar até um terço do período a que o empregado tem direito e deve ser solicitado até 15 dias antes do fim do período aquisitivo, com prova da manifestação arquivada."/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Remuneração e situações especiais"/>
      <TextBlock Style="{StaticResource RuleText}" Text="A remuneração pode envolver dias de férias, adicional constitucional de um terço, abono, médias de horas extras e verbas variáveis, adicionais noturno, de insalubridade ou periculosidade, comissões, produção e eventual pagamento em dobro. O cálculo deve possuir memória detalhada e reproduzível."/>
      <TextBlock Style="{StaticResource RuleText}" Text="Férias coletivas, empregado com menos de 12 meses, familiares no mesmo estabelecimento, estudante menor de 18 anos, afastamentos previdenciários, licença-maternidade, suspensão ou interrupção contratual e rescisão exigem tratamento específico."/>
      <TextBlock Style="{StaticResource RuleText}" Text="Hipóteses de perda ou reinício do período, interrupções durante as férias e conflitos entre lei, convenção e situação cadastral devem gerar pendência para análise do RH, sem decisão automática."/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Configurações aplicadas"/>
      <Border Background="#EDF6FF" CornerRadius="8" Padding="15">
       <StackPanel>
        <TextBlock Text="Bloquear férias com menos de 30 dias de antecedência" FontSize="15" FontWeight="Bold" Foreground="#0866C6"/>
        <TextBlock Style="{StaticResource RuleText}" Text="Marcada: datas que não cumprem os 30 dias ficam indisponíveis no calendário e o agendamento é rejeitado."/>
        <TextBlock Style="{StaticResource RuleText}" Text="Desmarcada: o agendamento pode ser concluído, mas o sistema exibe um aviso de antecedência."/>
       <TextBlock Style="{StaticResource RuleText}" Text="A opção marcada é o padrão seguro. A escolha é salva no arquivo configuracoes.json e reaplicada nas próximas execuções."/>
       <TextBlock Text="Bloquear início antes do repouso semanal" FontSize="15" FontWeight="Bold" Foreground="#0866C6" Margin="0,14,0,0"/>
       <TextBlock Style="{StaticResource RuleText}" Text="Marcada: bloqueia parcelas iniciadas na sexta-feira ou no sábado, considerando o domingo como repouso semanal padrão."/>
       <TextBlock Style="{StaticResource RuleText}" Text="Desmarcada: permite esses inícios, mas registra um aviso para conferência do RH."/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Referências oficiais"/>
      <TextBlock Style="{StaticResource RuleText}">
       <Hyperlink NavigateUri="https://www.planalto.gov.br/ccivil_03/decreto-lei/del5452compilado.htm" RequestNavigate="ReferenceNavigate">CLT compilada — artigos 129 a 145</Hyperlink>
      </TextBlock>
      <TextBlock Style="{StaticResource RuleText}">
       <Hyperlink NavigateUri="https://www.tst.jus.br/en/ferias1" RequestNavigate="ReferenceNavigate">Tribunal Superior do Trabalho — orientações sobre férias</Hyperlink>
      </TextBlock>
      <TextBlock Style="{StaticResource RuleText}" Foreground="{StaticResource MutedBrush}" Text="Consulte sempre as fontes vigentes e o instrumento coletivo aplicável antes da decisão final."/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
   <Grid>
    <TextBlock Text="Em casos ambíguos, registre uma pendência e encaminhe ao RH." VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
    <Button Content="Entendi" HorizontalAlignment="Right" Background="#0878E8" Foreground="White" Click="CloseClick"/>
   </Grid>
  </Border>
 </Grid>
</Window>
