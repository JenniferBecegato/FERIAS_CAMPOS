<Window x:Class="FeriasCampos.Views.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:texts="clr-namespace:FeriasCampos.Properties" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{StaticResource rulesIcon}" Title="{x:Static texts:ScreenTexts.RulesWindow_RegrasDeFerias}"
        Width="1040" Height="780" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
 <Window.Resources>
  <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
   <Setter Property="Margin" Value="0,0,0,14"/>
   <Setter Property="Padding" Value="20"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="18"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="RuleText" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="LineHeight" Value="22"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,3"/>
  </Style>
  <Style x:Key="TableCell" TargetType="Border">
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="12,8"/>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,22">
   <Grid>
    <StackPanel>
     <StackPanel Orientation="Horizontal"><Image Source="{StaticResource rulesIcon}" Width="30" Height="30" Margin="0,0,10,0"/><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_RegrasDeFerias}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_ManualDeConsultaParaProgramacaoEConferencia}" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
    </StackPanel>
    <Button Content="{x:Static texts:ScreenTexts.RulesWindow_Fechar}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseClick"/>
   </Grid>
  </Border>

  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="28,22,28,12" MaxWidth="980">
    <Border Background="#FFF7E6" BorderBrush="#F5C66D" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_ConteudoOrientativo}" FontSize="15" FontWeight="Bold" Foreground="#A35A00"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_EsteManualResumeRegrasGeraisDaCLTEle}"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static texts:ScreenTexts.RulesWindow_VisaoRapida}"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Background="#ECFDF5" CornerRadius="8" Padding="15">
        <StackPanel>
         <TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_Permitido}" Foreground="#11845B" FontSize="16" FontWeight="Bold" Margin="0,0,0,7"/>
         <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_ProgramarDentroDoSaldoEDoPeriodoConcessivo}"/>
         <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_DividirEmAteTresParcelasComConcordanciaDo}"/>
         <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_ConverterAteUmTercoDoDireitoEmAbono}"/>
         <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_AplicarRegraColetivaMaisFavoravelAposConferenciaDo}"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Background="#FFF1F2" CornerRadius="8" Padding="15">
        <StackPanel>
         <TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_NaoPermitido}" Foreground="#C6283A" FontSize="16" FontWeight="Bold" Margin="0,0,0,7"/>
         <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_AgendarMaisDiasDoQueOSaldoDisponivel}"/>
         <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_CriarQuartaParcelaOuParcelaComMenosDe}"/>
         <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_IniciarNosDoisDiasAnterioresAFeriadoOu}"/>
         <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_ImporUnilateralmenteAVendaDeDiasOuDescontar}"/>
        </StackPanel>
       </Border>
      </Grid>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static texts:ScreenTexts.RulesWindow_ComoOSistemaFuncionaAtualmente}"/>
      <WrapPanel Margin="0,0,0,10">
       <Border Background="#FFE5E8" CornerRadius="12" Padding="10,5" Margin="0,0,8,6"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_BLOQUEADOPELOSISTEMA}" Foreground="#C6283A" FontSize="12" FontWeight="Bold"/></Border>
       <Border Background="#FFF3D6" CornerRadius="12" Padding="10,5" Margin="0,0,8,6"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_PERMITIDOCOMAVISO}" Foreground="#A35A00" FontSize="12" FontWeight="Bold"/></Border>
       <Border Background="#E8F1FF" CornerRadius="12" Padding="10,5" Margin="0,0,8,6"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_CONFERENCIADORH}" Foreground="#0866C6" FontSize="12" FontWeight="Bold"/></Border>
      </WrapPanel>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_OSistemaValidaEmConjuntoAsParcelasNovas}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_OSistemaBloqueiaOInicioNosDoisDias}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_ConsiderandoODomingoComoRepousoSemanalPadraoInicios}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_AAntecedenciaInferiorA30DiasPodeSer}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_OAbonoERegistradoJuntoAsParcelasE}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_FaltasAfastamentosPagamentoFeriasColetivasRegrasFamiliaresConvencoes}"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static texts:ScreenTexts.RulesWindow_AquisicaoConcessaoEVencimento}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_ODireitoEAdquiridoAposCadaPeriodoDe}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_FeriasConcedidasDepoisDoPeriodoConcessivoExigemTratamento}"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static texts:ScreenTexts.RulesWindow_FaltasInjustificadas}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_AQuantidadeDeFaltasInjustificadasAlteraOTotal}" Margin="0,0,0,12"/>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" CornerRadius="6">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Border Style="{StaticResource TableCell}" Background="#F1F5F9"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_FaltasNoPeriodoTrabalhadoQueGerouODireito}" FontWeight="Bold" TextWrapping="Wrap"/></Border>
        <Border Grid.Column="1" Style="{StaticResource TableCell}" Background="#F1F5F9"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_DireitoAFerias}" FontWeight="Bold"/></Border>
        <Border Grid.Row="1" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_Ate5}"/></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_30Dias}"/></Border>
        <Border Grid.Row="2" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_6A14}"/></Border><Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_24Dias}"/></Border>
        <Border Grid.Row="3" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_15A23}"/></Border><Border Grid.Row="3" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_18Dias}"/></Border>
        <Border Grid.Row="4" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_24A32}"/></Border><Border Grid.Row="4" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_12Dias}"/></Border>
        <Border Grid.Row="5" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_MaisDe32}"/></Border><Border Grid.Row="5" Grid.Column="1" Style="{StaticResource TableCell}"><TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_SemDireitoNoPeriodo}"/></Border>
       </Grid>
      </Border>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static texts:ScreenTexts.RulesWindow_FracionamentoEInicioDasFerias}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_OFracionamentoExigeConcordanciaDoEmpregadoEAdmite}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_OInicioEProibidoNosDoisDiasAnteriores}"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static texts:ScreenTexts.RulesWindow_AvisoPagamentoEAbonoPecuniario}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_OAvisoDeveSerEscritoEEntregueCom}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_OAbonoEUmaOpcaoDoEmpregadoNunca}"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static texts:ScreenTexts.RulesWindow_RemuneracaoESituacoesEspeciais}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_ARemuneracaoPodeEnvolverDiasDeFeriasAdicional}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_FeriasColetivasEmpregadoComMenosDe12Meses}"/>
      <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_HipotesesDePerdaOuReinicioDoPeriodoInterrupcoes}"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static texts:ScreenTexts.RulesWindow_ConfiguracoesAplicadas}"/>
      <Border Background="#EDF6FF" CornerRadius="8" Padding="15">
       <StackPanel>
        <TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_BloquearFeriasComMenosDe30DiasDe}" FontSize="15" FontWeight="Bold" Foreground="#0866C6"/>
        <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_MarcadaDatasQueNaoCumpremOs30Dias}"/>
        <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_DesmarcadaOAgendamentoPodeSerConcluidoMasO}"/>
       <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_AOpcaoMarcadaEOPadraoSeguroA}"/>
       <TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_BloquearInicioAntesDoRepousoSemanal}" FontSize="15" FontWeight="Bold" Foreground="#0866C6" Margin="0,14,0,0"/>
       <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_MarcadaBloqueiaParcelasIniciadasNaSextaFeiraOu}"/>
       <TextBlock Style="{StaticResource RuleText}" Text="{x:Static texts:ScreenTexts.RulesWindow_DesmarcadaPermiteEssesIniciosMasRegistraUmAviso}"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource SectionCard}">
     <StackPanel>
      <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static texts:ScreenTexts.RulesWindow_ReferenciasOficiais}"/>
      <TextBlock Style="{StaticResource RuleText}">
       <Hyperlink NavigateUri="https://www.planalto.gov.br/ccivil_03/decreto-lei/del5452compilado.htm" RequestNavigate="ReferenceNavigate"><Run Text="{x:Static texts:ScreenTexts.RulesWindow_ReferenciaClt}"/></Hyperlink>
      </TextBlock>
      <TextBlock Style="{StaticResource RuleText}">
       <Hyperlink NavigateUri="https://www.tst.jus.br/en/ferias1" RequestNavigate="ReferenceNavigate"><Run Text="{x:Static texts:ScreenTexts.RulesWindow_ReferenciaTst}"/></Hyperlink>
      </TextBlock>
      <TextBlock Style="{StaticResource RuleText}" Foreground="{StaticResource MutedBrush}" Text="{x:Static texts:ScreenTexts.RulesWindow_ConsulteSempreAsFontesVigentesEOInstrumento}"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
   <Grid>
    <TextBlock Text="{x:Static texts:ScreenTexts.RulesWindow_EmCasosAmbiguosRegistreUmaPendenciaEEncaminhe}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
    <Button Content="{x:Static texts:ScreenTexts.RulesWindow_Entendi}" HorizontalAlignment="Right" Background="#0878E8" Foreground="White" Click="CloseClick"/>
   </Grid>
  </Border>
 </Grid>
</Window>
