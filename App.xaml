<Application x:Class="FeriasCampos.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <BitmapImage x:Key="programIcon" UriSource="pack://application:,,,/ControleFerias;component/Resource/program.ico"/>
    <BitmapImage x:Key="homeIcon" UriSource="pack://application:,,,/ControleFerias;component/Resource/home.ico"/>
    <BitmapImage x:Key="dashboardIcon" UriSource="pack://application:,,,/ControleFerias;component/Resource/dashboard.ico"/>
    <BitmapImage x:Key="personIcon" UriSource="pack://application:,,,/ControleFerias;component/Resource/person.ico"/>
    <BitmapImage x:Key="importIcon" UriSource="pack://application:,,,/ControleFerias;component/Resource/import.ico"/>
    <BitmapImage x:Key="travelIcon" UriSource="pack://application:,,,/ControleFerias;component/Resource/travel.ico"/>
    <BitmapImage x:Key="summerIcon" UriSource="pack://application:,,,/ControleFerias;component/Resource/summer.png"/>
    <BitmapImage x:Key="rulesIcon" UriSource="pack://application:,,,/ControleFerias;component/Resource/rules.ico"/>
    <BitmapImage x:Key="settingsIcon" UriSource="pack://application:,,,/ControleFerias;component/Resource/settings.ico"/>
    <SolidColorBrush x:Key="InkBrush" Color="#10213E"/><SolidColorBrush x:Key="MutedBrush" Color="#5F6B7A"/><SolidColorBrush x:Key="PrimaryBrush" Color="#0878E8"/><SolidColorBrush x:Key="BorderBrush" Color="#E4E9F0"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/></Style>
  </Application.Resources>
</Application>
